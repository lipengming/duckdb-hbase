# name: test/sql/hbase_basic.test
# description: hbase 扩展注册、参数校验与错误路径（不依赖 Gateway 运行）
# group: [sql]

require hbase

# 扩展注册成功，版本可读
query I
SELECT length(hbase_version()) > 0;
----
true

# 未注册连接直接扫描：报错且提示如何注册
statement error
SELECT * FROM hbase_scan('missing', 'default', 't');
----
未注册

# endpoint 缺少端口（解析阶段失败，不发起网络请求）
statement error
SELECT hbase_connect('bad', 'grpc://127.0.0.1');
----
端口

# 不支持的 scheme（解析阶段失败）
statement error
SELECT hbase_connect('bad', 'ftp://127.0.0.1:21');
----
scheme

# 端点为 NULL：沿用 DuckDB 默认 NULL 传播语义，函数不被调用，结果为 NULL
query I
SELECT hbase_connect(NULL, 'grpc://127.0.0.1:18080') IS NULL;
----
true

# 断开一个从未注册的连接：返回 false
query I
SELECT hbase_disconnect('nope');
----
false
